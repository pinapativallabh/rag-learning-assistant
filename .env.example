# RAG Learning Assistant Configuration

# AI Provider Configuration (Chat / Generation)
# AI_PROVIDER can be 'ollama' or 'gemini'
AI_PROVIDER=ollama
AI_MODEL=llama3:8b

# Embedding Provider Configuration
# EMBEDDING_PROVIDER can be 'ollama' or 'gemini'
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text

# Optional: Ollama Base URL (default is usually http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Optional: Google Gemini API key (required if using 'gemini' provider)
GEMINI_API_KEY=your_gemini_api_key_here
